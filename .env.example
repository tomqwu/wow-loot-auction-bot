# Discord bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your-bot-token

# Application ID from the General Information page of your Discord application
DISCORD_CLIENT_ID=123456789012345678

# Guild (server) ID to register slash commands in. Recommended for instant command
# updates while developing. If omitted, commands are registered globally (can take
# up to an hour to propagate).
DISCORD_GUILD_ID=123456789012345678

# Path to the SQLite database file. SQLITE_PATH takes precedence over DATABASE_URL.
# DATABASE_URL also accepts sqlite:./data/auction.db or file:./data/auction.db.
SQLITE_PATH=./data/auction.db
# DATABASE_URL=sqlite:./data/auction.db

# Comma-separated role names allowed to start/close/cancel/settle auctions.
OFFICER_ROLES=Raid Leader,Auctioneer

# Bid/ledger denomination (in-game units only): points (default), dkp, gold.
CURRENCY_UNIT=points

# Game version used for Wowhead links: classic (default), era, sod, tbc, wotlk,
# cata, mop, retail
GAME_VERSION=classic
